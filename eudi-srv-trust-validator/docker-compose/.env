# Entorno del Trust Validator local.
#
# LOTL_LOCATION es LA variable de este despliegue: la URL de la lista de listas
# de confianza contra la que se validan las cadenas. Apunta al publicador
# LOCAL (`srv-tl-publisher`), no al remoto de civica.avance.org.co: de eso se
# trata.

# Imagen del servicio. Se construye con:  cd .. && ./gradlew bootBuildImage
TRUST_VALIDATOR_IMAGE=trust-validator:local

# Lista de listas de confianza local.
LOTL_LOCATION=https://civica-desarrollo.avance.org.co/tl-publisher/LOTL/current.xml

# Comprobacion de revocacion (CRL) al validar la cadena.
TRUST_VALIDATOR_REVOCATION_CHECK=false

# Nivel de log de DSS. INFO por defecto; DEBUG para ver que hace con las listas.
DSS_LOG_LEVEL=DEBUG
